{
  "name": "web-inspector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:fixtures": "node --conditions=react-server --import tsx tests/fixtures/run.ts",
    "collect": "node --conditions=react-server --import tsx scripts/collect.ts",
    "detect": "node --conditions=react-server --import tsx scripts/detect.ts",
    "fixtures:shots": "node --conditions=react-server --import tsx scripts/fixture-screenshots.ts",
    "test:security": "vitest run --config vitest.security.config.mts",
    "ui:shots": "node --import tsx scripts/ui-shots.ts"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.9.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
